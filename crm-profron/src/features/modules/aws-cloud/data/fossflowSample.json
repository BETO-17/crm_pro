  "items": [
    {
      "id": "users",
      "name": "Admin / RRHH y Empleados",
      "description": "Navegador web. Admin gestiona empleados, horarios, áreas, impuestos y estadísticas; empleados marcan asistencia con la cámara (reconocimiento facial).",
      "icon": "user"
    },
    {
      "id": "nginx",
      "name": "Nginx reverse proxy (VPS)",
      "description": "SSL Let's Encrypt, redirección 80→443, client_max_body_size 10M. Dominios: lumnia.cabanillas.net.pe y lumina-backend.cabanillas.net.pe.",
      "icon": "loadbalancer"
    },
    {
      "id": "frontend",
      "name": "lumina-frontend",
      "description": "Astro 4 + React 18 + Tailwind + shadcn/ui. Build estático servido por Nginx. Host 5187 → contenedor 80. PUBLIC_API_URL embebida en el build.",
      "icon": "desktop"
    },
    {
      "id": "backend",
      "name": "lumina-backend",
      "description": "Node 20 + Express. Rutas: admin, empleados, asistencia, horarios, áreas, asignaciones, justificaciones, reconocimiento, historial, log-reconocimiento. Host 5186 → contenedor 3000.",
      "icon": "server"
    },
    {
      "id": "face",
      "name": "face_api",
      "description": "Microservicio FastAPI + face_recognition (stateless). Endpoints: /generate (embedding 128 floats), /compare, /verify. Puerto 8000.",
      "icon": "function-module"
    },
    {
      "id": "pg",
      "name": "Supabase PostgreSQL",
      "description": "Base de datos (bd.sql + migrations). Conexión con pg Pool vía pooler puerto 6543 con SSL.",
      "icon": "storage"
    },
    {
      "id": "storage",
      "name": "Supabase Storage",
      "description": "Bucket empleado_fotos con las fotos de los empleados (supabase-js).",
      "icon": "image"
    },
    {
      "id": "vercel",
      "name": "Vercel (despliegue alterno)",
      "description": "lumina-delta-brown.vercel.app. Frontend estático + backend Express como función serverless (api/index.js).",
      "icon": "cloud"
    }
